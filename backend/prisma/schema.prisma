generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quadra {
  id                     String   @id @default(uuid())
  name                   String
  slug                   String   @unique
  active                 Boolean  @default(true)
  mercadoPagoAccessToken String?  @map("mercado_pago_access_token")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users    User[]
  products Product[]
  rachas   Racha[]
  courts   Court[]

  @@map("quadras")
}

enum UserRole {
  OWNER
  SUPERADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(OWNER)
  quadraId  String?  @map("quadra_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quadra Quadra? @relation(fields: [quadraId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  photoUrl  String?  @map("photo_url")
  quadraId  String   @map("quadra_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quadra Quadra      @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  items  RachaItem[]

  @@map("products")
}

enum RachaStatus {
  ABERTA
  FECHADA
}

model Racha {
  id            String      @id @default(uuid())
  courtValue    Decimal     @map("court_value") @db.Decimal(10, 2)
  playersCount  Int         @map("players_count")
  totalValue    Decimal     @map("total_value") @db.Decimal(10, 2)
  valuePerHead  Decimal     @map("value_per_head") @db.Decimal(10, 2)
  status        RachaStatus @default(FECHADA)
  playedAt      DateTime    @default(now()) @map("played_at")
  quadraId      String      @map("quadra_id")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  quadra Quadra      @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  items  RachaItem[]

  @@map("rachas")
}

model RachaItem {
  id         String   @id @default(uuid())
  rachaId    String   @map("racha_id")
  productId  String?  @map("product_id")
  name       String
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity   Int
  createdAt  DateTime @default(now())

  racha   Racha    @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("racha_items")
}

model Court {
  id                String   @id @default(uuid())
  name              String
  quadraId          String   @map("quadra_id")
  hourlyRate        Decimal  @map("hourly_rate") @db.Decimal(10, 2)
  slotMinutes       Int      @default(60) @map("slot_minutes")
  extraBlockMinutes Int      @default(0) @map("extra_block_minutes")
  extraBlockPrice   Decimal? @map("extra_block_price") @db.Decimal(10, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quadra   Quadra       @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  hours    CourtHours[]
  blocks   CourtBlock[]
  bookings Booking[]

  @@map("courts")
}

model CourtHours {
  id        String  @id @default(uuid())
  courtId   String  @map("court_id")
  weekday   Int
  openTime  String  @map("open_time")
  closeTime String  @map("close_time")
  closed    Boolean @default(false)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, weekday])
  @@map("court_hours")
}

model CourtBlock {
  id        String   @id @default(uuid())
  courtId   String   @map("court_id")
  date      DateTime @db.Date
  startTime String?  @map("start_time")
  endTime   String?  @map("end_time")
  reason    String?
  createdAt DateTime @default(now())

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_blocks")
}

enum BookingStatus {
  CONFIRMADA
  CANCELADA
  PENDENTE_PAGAMENTO
}

model Booking {
  id             String        @id @default(uuid())
  courtId        String        @map("court_id")
  date           DateTime      @db.Date
  startTime      String        @map("start_time")
  endTime        String        @map("end_time")
  customerName   String        @map("customer_name")
  customerPhone  String        @map("customer_phone")
  totalPrice     Decimal       @map("total_price") @db.Decimal(10, 2)
  status         BookingStatus @default(CONFIRMADA)
  cancelToken    String        @unique @default(uuid()) @map("cancel_token")
  depositAmount  Decimal?      @map("deposit_amount") @db.Decimal(10, 2)
  pixPaymentId   String?       @map("pix_payment_id")
  holdExpiresAt  DateTime?     @map("hold_expires_at")
  createdAt      DateTime      @default(now())

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, date])
  @@map("bookings")
}
