# Copie para .env.prod no servidor e preencha os valores reais.
# Nunca commite o .env.prod com valores reais.

POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Chave usada para criptografar o Access Token do Mercado Pago de cada arena no banco
TOKEN_ENCRYPTION_KEY=troque-por-outro-segredo-longo-e-aleatorio

# Origem pública do frontend (usada para CORS)
PUBLIC_ORIGIN=https://SEU_DOMINIO

# Origem pública da API. Com o nginx fazendo proxy de /api para o backend,
# normalmente é o mesmo domínio do frontend, sem porta.
API_ORIGIN=https://SEU_DOMINIO
